(cors) {
	@cors_preflight {
		method OPTIONS
		header Origin *
		header Access-Control-Request-Method *
	}
	handle @cors_preflight {
		header {
			Access-Control-Allow-Origin *
			Access-Control-Allow-Methods "GET,HEAD,OPTIONS"
			Access-Control-Allow-Headers "Origin,Accept,Content-Type,Authorization,X-Requested-With,Cache-Control,Pragma"
			Access-Control-Max-Age 86400
			Vary "Origin,Access-Control-Request-Method,Access-Control-Request-Headers"
		}
		respond "" 204
	}

	@cors_request header Origin *
	header @cors_request {
		Access-Control-Allow-Origin *
		Vary Origin
	}
}

localhost:80 {
	import cors

	reverse_proxy av-web-service:8080

	log stdout
}

